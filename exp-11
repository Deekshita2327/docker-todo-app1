const express = require('express');
const app = express();

app.use(express.json());

app.get('/hello', (req, res) => {
    res.send('Hello from JavaScript');
});

app.post('/add', (req, res) => {
    const { a, b } = req.body;
    res.json({ result: a + b });
});

app.listen(3000, () => {
    console.log('Server running at http://localhost:3000');
});
